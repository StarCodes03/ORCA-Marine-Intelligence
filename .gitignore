# ==============================================================================
# ORCA Marine Intelligence - .gitignore
# Python (FastAPI / LangGraph) + Frontend (React / Vite / TypeScript)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage / pytest caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
cover/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node / NPM / Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Frontend Build Outputs (Vite)
frontend/dist/
frontend/dist-ssr/
frontend/build/
dist/

# Editor & IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs and runtime traces
*.log
logs/
*.sqlite
*.sqlite3

# Environment and Secrets
.env
.env.*
!.env.example
