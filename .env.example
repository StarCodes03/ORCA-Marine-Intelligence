# ===================================================
# ORCA — Marine Ecosystem Intelligence Environment Config
# ===================================================

# Environment mode: development / production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Integration (Optional)
# If left blank or unset, ORCA operates in deterministic development/mock mode.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Open-Meteo Live APIs (Open Access — No API Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1
OPEN_METEO_TIMEOUT=4.0

# Earth Observation & Ocean Color (Optional Credentials)
# When unset, ORCA discloses UNAVAILABLE state for satellite chlorophyll-a
# COPERNICUS_API_KEY=
# NOAA_COASTWATCH_URL=https://coastwatch.pfeg.noaa.gov/erddap/griddap/erdVH3chla1day.json

# Persistent Storage & Database Configuration
# Defaults to local SQLite repository
DATABASE_URL=sqlite:///./orca_marine.db

# Prototype Demo Sector
DEMO_SECTOR_NAME="Kochi, Kerala (Arabian Sea)"
DEMO_DEFAULT_LAT=9.9312
DEMO_DEFAULT_LON=76.2673
