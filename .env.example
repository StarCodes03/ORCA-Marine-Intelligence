# ===================================================
# ORCA — Marine Ecosystem Intelligence Environment Config
# ===================================================

# Environment mode: development / production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Integration (Optional)
# If left blank or unset, ORCA operates in deterministic development/mock mode.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Prototype Demo Sector
DEMO_SECTOR_NAME="Kochi, Kerala (Arabian Sea)"
DEMO_DEFAULT_LAT=9.9312
DEMO_DEFAULT_LON=76.2673

# Future PostGIS Architecture Settings (Milestone 2+)
# DATABASE_URL=postgresql://orca_user:orca_password@localhost:5432/orca_db
